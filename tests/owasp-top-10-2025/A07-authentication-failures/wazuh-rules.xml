<!-- Add to /var/ossec/etc/rules/local_rules.xml on the Wazuh manager. -->
<group name="local,web,nginx,owasp,authentication_failed,">

  <rule id="119972" level="5">
    <if_sid>31101</if_sid>
    <protocol>POST</protocol>
    <url type="pcre2">^/rest/user/login(?:\?.*)?$</url>
    <id>401</id>
    <description>OWASP A07: Juice Shop authentication failure from $(srcip).</description>
    <group>authentication_failed,web,nginx,owasp_a07,</group>
  </rule>

  <rule id="119973" level="10" frequency="5" timeframe="300">
    <if_matched_sid>119972</if_matched_sid>
    <same_srcip />
    <description>OWASP A07: Five Juice Shop authentication failures from $(srcip) within five minutes.</description>
    <mitre>
      <id>T1110</id>
    </mitre>
    <group>authentication_failures,web,nginx,owasp_a07,</group>
  </rule>

</group>
